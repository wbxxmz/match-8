  <xacro:property name="berxel_arm_base_link_r" value="${calib_props['berxel_arm_base_link']['rpy'][0]}"/>
  <xacro:property name="berxel_arm_base_link_p" value="${calib_props['berxel_arm_base_link']['rpy'][1]}"/>
  <xacro:property name="berxel_arm_base_link_yaw" value="${calib_props['berxel_arm_base_link']['rpy'][2]}"/>

  <!-- tof_top_link -->
  <xacro:property name="tof_top_link_x" value="${calib_props['tof_top_link']['xyz'][0]}"/>
  <xacro:property name="tof_top_link_y" value="${calib_props['tof_top_link']['xyz'][1]}"/>
  <xacro:property name="tof_top_link_z" value="${calib_props['tof_top_link']['xyz'][2]}"/>
  <xacro:property name="tof_top_link_r" value="${calib_props['tof_top_link']['rpy'][0]}"/>
