  <!-- tof_top_link -->
  <xacro:property name="line_laser_down_link_x" value="${calib_props['line_laser_down_link']['xyz'][0]}"/>
  <xacro:property name="line_laser_down_link_y" value="${calib_props['line_laser_down_link']['xyz'][1]}"/>
  <xacro:property name="line_laser_down_link_z" value="${calib_props['line_laser_down_link']['xyz'][2]}"/>
